package de.uniwue.jpp.encoder;

import java.util.*;

public class FixedEncoder extends AbstractChainableEncoder {

	Encoder delegate;
	HashMap<Character, Character> map;
	HashMap<Character, List<Character>>  valueToKeys = new HashMap<>();



	public FixedEncoder(Encoder delegate, HashMap<Character, Character> map) throws EncoderCreationException {
		super(delegate);
		if (delegate==null) throw new EncoderCreationException("delegate darf nicht den Wert null sein");
		if (map==null) throw new EncoderCreationException("map darf nicht den Wert null sein");
		if (map.size()!=26) throw new EncoderCreationException("beinhaltet nicht alle 26 Buchstaben des Alphabets");

		for (Map.Entry<Character, Character> entry : map.entrySet()) {
			Character value = entry.getValue();
			Character key = entry.getKey();

			if (valueToKeys.containsKey(value)) {
				throw new EncoderCreationException("Doppelter Wert '" + value + "' gefunden bei Keys '"
						+ valueToKeys.get(value) +
						"' und '" + key + "'");
			}

			List<Character> keyList = new ArrayList<>();
			keyList.add(key);
			valueToKeys.put(value, keyList);
		}
		for (Map.Entry<Character, Character> entry : map.entrySet()) {
			char key = entry.getKey();
			char value = entry.getValue();
			if (key > 'z') throw new EncoderCreationException("Ungültiges Zeichen IN MAP: " + key + "->" + value);
			if (key < 'a') throw new EncoderCreationException("Ungültiges Zeichen IN MAP: " + key + "->" + value);
			if (value < 'a') throw new EncoderCreationException("Ungültiges Zeichen IN MAP: " + key + "->" + value);
			if (value > 'z') throw new EncoderCreationException("Ungültiges Zeichen IN MAP: " + key + "->" + value);

		}

		this.delegate=delegate;
		this.map=new HashMap<>(map);
	}

	@Override
	public char encode(char c) throws EncoderInputException {
		if (map == null) {
			throw new EncoderInputException("Mapping wurde nicht initialisiert.");
		}
		if (!map.containsKey(c)) throw new EncoderInputException("Ungültiges Zeichen: " + c);


		return map.get(c);
	}

	@Override
	public void rotate(boolean carry) {
		delegate.rotate(carry);
	}

	@Override
	public boolean equals(Object o) {
		if (o == null || getClass() != o.getClass()) return false;
		FixedEncoder that = (FixedEncoder) o;
		return  Objects.equals(map, that.map);
	}

	@Override
	public int hashCode() {
		return Objects.hash(map);
	}

	@Override
	public String toString() {
		List<Character> list = new ArrayList<>(map.keySet());
		Collections.sort(list);

		StringBuilder sb = new StringBuilder();
		for (int i = 0; i < list.size(); i++) {
			sb.append(list.get(i));
			sb.append("->");
			sb.append(map.get(list.get(i)));
			//sb.append("\n");
			//sb.append("\n");
			if (i < list.size()-1 ) {
				sb.append("\n");
			}
		}
		return sb.toString();
	}
}